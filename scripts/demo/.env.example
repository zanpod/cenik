# EPO.SI — demo provisioning: nastavitve okolja
# Kopirajte to datoteko v ".env" (v isti mapi) in izpolnite vrednosti.
# ".env" je v .gitignore — nikoli ga ne commitajte.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → service_role key (SKRIVNOST!)
# Ta ključ obide RLS (Row Level Security) — namenjen je IZKLJUČNO temu, da
# skript lahko piše v bazo mimo omejitev, ki veljajo za brskalnik. Nikoli ga
# ne uporabite v frontend kodi in ga ne delite naprej.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Domena, kjer je meni v živo — uporabi se v izpisanih povezavah in QR kodah.
APP_DOMAIN=https://demo.agencijaepo.si
